# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Firebase Admin SDK
# Download service account JSON from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: Path to service account JSON file (alternative to individual env vars)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase Web API Key (from Firebase Console > Project Settings > General)
# Required for client-side auth operations proxied through the API (login, refresh, password reset, etc.)
FIREBASE_API_KEY=your-firebase-web-api-key

# Token settings
# Session cookie / custom token expiry (in seconds) - used where applicable
TOKEN_EXPIRES_IN=3600
